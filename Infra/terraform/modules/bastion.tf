// Bastion host for accessing private EKS cluster

data "aws_ami" "ubuntu_latest" {
  most_recent = true
  owners      = ["099720109477"] # Canonical

  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"]
  }
}

resource "aws_instance" "bastion" {
  count         = var.create_bastion ? 1 : 0
  ami           = data.aws_ami.ubuntu_latest.id
  instance_type = var.bastion_instance_type

  subnet_id = aws_subnet.public-subnet[var.bastion_public_subnet_index].id

  # Ensure a public IP is assigned
  associate_public_ip_address = true

  # Attach bastion-only security group
  vpc_security_group_ids = [aws_security_group.bastion-sg.id]

  # Key pair to allow SSH access (generated by TLS below)
  key_name = aws_key_pair.bastion_key[0].key_name

  root_block_device {
    volume_size = 60
    volume_type = "gp3"
  }

  tags = {
    Name = "${var.resource_prefix}-bastion"
    Env  = var.env
  }

  user_data = <<-EOF
  #!/usr/bin/env bash
  set -eux
  apt-get update
  apt-get install -y ca-certificates curl gnupg lsb-release unzip apt-transport-https

  # Install AWS CLI v2
  curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "/tmp/awscliv2.zip"
  unzip /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install -i /usr/local/aws-cli -b /usr/local/bin || true

  # Install kubectl (stable)
  KUBECTL_VERSION=$(curl -L -s https://dl.k8s.io/release/stable.txt)
  curl -LO "https://dl.k8s.io/release/${"$"}KUBECTL_VERSION/bin/linux/amd64/kubectl"
  install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl

  # Install Helm
  curl https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash

  # Clean up
  rm -rf /tmp/aws /tmp/awscliv2.zip kubectl || true
  EOF

  depends_on = [aws_internet_gateway.igw]
}

// Generate an SSH keypair (private key returned in PEM format)
resource "tls_private_key" "bastion" {
  count     = var.create_bastion ? 1 : 0
  algorithm = "RSA"
  rsa_bits  = 4096
}

resource "aws_key_pair" "bastion_key" {
  count      = var.create_bastion ? 1 : 0
  key_name   = "${var.resource_prefix}-bastion"
  public_key = tls_private_key.bastion[0].public_key_openssh
}

